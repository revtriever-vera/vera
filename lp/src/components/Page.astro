---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ChatDemo from './ChatDemo.astro';
import Revtriever from './Revtriever.astro';
import type { Dict } from '../i18n/pt';
import { pt } from '../i18n/pt';
import { en } from '../i18n/en';
import visao from '../assets/visao.png';
import aporte from '../assets/aporte.png';
import cortes from '../assets/cortes.png';

interface Props {
  t: Dict;
}
const { t } = Astro.props;

const base = import.meta.env.BASE_URL;
const home = `${base}${t.path.replace(/^\//, '')}`;
const other = t.path === pt.path ? en : pt;
const otherHref = `${base}${other.path.replace(/^\//, '')}`;
const signup = import.meta.env.PUBLIC_APP_URL ?? '#' + t.plans.id;
const repo = 'https://github.com/revtriever-vera/vera';
const sizes = '(min-width: 1120px) 620px, (min-width: 900px) 56vw, 92vw';
const widths = [480, 720, 960, 1280];
const links = [
  { href: `#${t.wealth.id}`, label: t.nav.wealth, hideSmall: true },
  { href: `#${t.spending.id}`, label: t.nav.spending, hideSmall: true },
  { href: `#${t.plans.id}`, label: t.nav.plans, hideSmall: true },
  { href: `#${t.operator.id}`, label: t.nav.operator, hideSmall: true },
  { href: otherHref, label: t.nav.otherLang, lang: other.lang },
];
---

<Base t={t}>
  <Header home={home} by={t.nav.by} byHref={`#${t.operator.id}`} navLabel={t.nav.label} links={links} />

  <main id="main">
    <div class="wrap">
      <div class="hero">
        <h1>{t.hero.h1}</h1>
        <p class="lead">{t.hero.lead}</p>
        <div class="cta">
          <a class="btn primary" href={signup}>{t.hero.primary}</a>
          <a class="btn" href={repo}>{t.hero.secondary}</a>
        </div>
        <p class="facts">{t.hero.facts}</p>
      </div>
      <figure class="shot hero-shot">
        <Image src={visao} alt={t.mock.alt} widths={[640, 960, 1280, 1600]} sizes="(min-width: 1120px) 1056px, 92vw" loading="eager" fetchpriority="high" format="webp" quality={72} />
        <figcaption>{t.mock.caption}</figcaption>
      </figure>
    </div>

    <div class="band">
      <div class="wrap sec">
        <section id={t.wealth.id} class="feature" aria-labelledby="wealth-h">
          <div class="txt">
            <h2 id="wealth-h">{t.wealth.title}</h2>
            <p>{t.wealth.text}</p>
            <ul class="list">{t.wealth.bullets.map(([b, s]) => <li><b>{b}:</b> {s}</li>)}</ul>
          </div>
          <figure class="shot">
            <Image src={aporte} alt={t.wealth.alt} widths={widths} sizes={sizes} loading="lazy" format="webp" quality={80} />
            <figcaption>{t.wealth.caption}</figcaption>
          </figure>
        </section>
        <section id={t.spending.id} class="feature" aria-labelledby="spending-h">
          <div class="txt">
            <h2 id="spending-h">{t.spending.title}</h2>
            <p>{t.spending.text}</p>
            <ul class="list">{t.spending.bullets.map(([b, s]) => <li><b>{b}:</b> {s}</li>)}</ul>
          </div>
          <figure class="shot">
            <Image src={cortes} alt={t.spending.alt} widths={widths} sizes={sizes} loading="lazy" format="webp" quality={80} />
            <figcaption>{t.spending.caption}</figcaption>
          </figure>
        </section>
        <section id={t.ask.id} class="feature" aria-labelledby="ask-h">
          <div class="txt">
            <h2 id="ask-h">{t.ask.title}</h2>
            <p>{t.ask.text}</p>
            <ul class="list">{t.ask.bullets.map(([b, s]) => <li><b>{b}:</b> {s}</li>)}</ul>
          </div>
          <ChatDemo question={t.ask.question} answer={t.ask.answer} thinking={t.ask.thinking} note={t.ask.disclaimer} label={t.ask.chatLabel} />
        </section>
      </div>
    </div>

    <section id={t.tracking.id} class="wrap sec" aria-labelledby="track-h">
      <div class="head"><h2 id="track-h">{t.tracking.title}</h2></div>
      <div class="cols">
        {
          t.tracking.items.map((it) => (
            <div>
              <span class="plan">{it.plan}</span>
              <h3>{it.title}</h3>
              <p>{it.text}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section id={t.importing.id} class="wrap sec flush" aria-labelledby="imp-h">
      <div class="head">
        <h2 id="imp-h">{t.importing.title}</h2>
        <p class="sub">{t.importing.sub}</p>
      </div>
      <div class="formats">
        {
          t.importing.groups.map((g) => (
            <div>
              <h3>{g.title}</h3>
              <ul class="list">{g.items.map((i) => <li>{i}</li>)}</ul>
            </div>
          ))
        }
      </div>
      <p class="fine">{t.importing.note}</p>
    </section>

    <div class="band">
      <section id={t.limits.id} class="wrap sec" aria-labelledby="lim-h">
        <div class="head"><h2 id="lim-h">{t.limits.title}</h2></div>
        <div class="cols two">
          {
            t.limits.items.map((it) => (
              <div>
                <h3>{it.title}</h3>
                <p>{it.text}</p>
              </div>
            ))
          }
        </div>
      </section>
    </div>

    <section id={t.operator.id} class="wrap sec" aria-labelledby="op-h">
      <div class="head">
        <h2 id="op-h">{t.operator.title}</h2>
        <p class="sub">{t.operator.sub}</p>
      </div>
      <div class="operator">
        <div class="rt-card">
          <Revtriever size={36} />
          <p>{t.operator.hosted.lead}</p>
          <p>{t.operator.hosted.about}</p>
          <dl>
            <dt>{t.operator.hosted.company}</dt><dd translate="no">{t.operator.hosted.companyValue}</dd>
            <dt>{t.operator.hosted.cnpj}</dt><dd>68.648.441/0001-38</dd>
            <dt>{t.operator.hosted.contact}</dt><dd><a href="mailto:contato@revtriever.com" translate="no">contato@revtriever.com</a></dd>
          </dl>
          <a class="btn" href="https://revtriever.com">{t.operator.hosted.cta}</a>
        </div>
        <div class="self">
          <h3>{t.operator.self.title}</h3>
          <p>{t.operator.self.text}</p>
          <p>{t.operator.self.text2}</p>
          <a class="btn" href={repo}>{t.operator.self.cta}</a>
        </div>
      </div>
    </section>

    <div class="band">
      <section id={t.plans.id} class="wrap sec" aria-labelledby="plans-h">
        <div class="head">
          <h2 id="plans-h">{t.plans.title}</h2>
          <p class="sub">{t.plans.sub}</p>
        </div>
        <div class="cards">
          <div class="card">
            <h3>{t.plans.free.name}</h3>
            <p class="price">{t.plans.free.price}</p>
            <ul class="list">{t.plans.free.items.map((b) => <li>{b}</li>)}</ul>
            <a class="btn" href={signup}>{t.plans.free.cta}</a>
          </div>
          <div class="card pro">
            <h3>{t.plans.premium.name}</h3>
            <p class="price">{t.plans.premium.price} <small>{t.plans.premium.per}</small></p>
            <ul class="list">{t.plans.premium.items.map((b) => <li>{b}</li>)}</ul>
            <p class="fine">{t.plans.premium.quota}</p>
            <a class="btn primary" href={signup}>{t.plans.premium.cta}</a>
          </div>
        </div>
        <p class="fine">{t.plans.billing}</p>
      </section>
    </div>

    <section id={t.faq.id} class="wrap sec" aria-labelledby="faq-h">
      <div class="head"><h2 id="faq-h">{t.faq.title}</h2></div>
      <div class="faq">
        {
          t.faq.items.map((it) => (
            <details>
              <summary>{it.q}</summary>
              <p>{it.a}</p>
            </details>
          ))
        }
      </div>
    </section>
  </main>

  <Footer f={t.footer} />
</Base>
