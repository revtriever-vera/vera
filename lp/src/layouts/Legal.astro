---
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
  title: string;
  path: string;
}
const { title, path } = Astro.props;
const root = new URL(import.meta.env.BASE_URL, Astro.site);
const canonical = new URL(path.replace(/^\//, ''), root).href;
const home = import.meta.env.BASE_URL;
const favicon = `${home}favicon.svg`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{`${title} · Vera`}</title>
    <meta name="theme-color" content="#fbf6f8" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="canonical" href={canonical} />
    <Font cssVariable="--font-nunito" />
  </head>
  <body>
    <a class="skip" href="#main">Ir para o conteúdo</a>
    <header class="legal-top wrap">
      <a href={home} class="legal-home">Vera</a>
      <nav aria-label="Documentos">
        <a href={`${home}privacidade/`}>Privacidade</a>
        <a href={`${home}termos/`}>Termos de uso</a>
        <a href={`${home}exclusao-de-dados/`}>Exclusão de dados</a>
      </nav>
    </header>
    <main id="main" class="legal wrap">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  .legal-top{display:flex;flex-wrap:wrap;gap:12px 24px;align-items:center;justify-content:space-between;padding-block:20px;border-bottom:1px solid var(--line)}
  .legal-top nav{display:flex;flex-wrap:wrap;gap:8px 20px;font-size:15px}
  .legal-top a{color:var(--ink-2)}
  .legal-home{font-weight:800;font-size:20px;color:var(--ink)!important;text-decoration:none}
  .legal{max-width:72ch;padding-block:40px 72px;color:var(--ink);line-height:1.65}
  .legal h1{font-size:clamp(28px,4vw,40px);line-height:1.15;margin:0 0 12px}
  .legal h2{font-size:21px;margin:40px 0 8px}
  .legal p,.legal li{font-size:17px}
  .legal ul,.legal ol{padding-left:1.25em}
  .legal li+li{margin-top:6px}
  .legal a{color:var(--accent-strong)}
  .legal code{font-size:.92em;background:var(--accent-soft);padding:1px 5px;border-radius:4px}
</style>
