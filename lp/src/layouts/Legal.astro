---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { pt } from '../i18n/pt';

interface Props {
  title: string;
  path: string;
}
const { title, path } = Astro.props;
const root = new URL(import.meta.env.BASE_URL, Astro.site);
const canonical = new URL(path.replace(/^\//, ''), root).href;
const home = import.meta.env.BASE_URL;
const favicon = `${home}favicon.svg`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{`${title} · Vera`}</title>
    <meta name="theme-color" content="#fbf6f8" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="canonical" href={canonical} />
    <Font cssVariable="--font-nunito" preload />
  </head>
  <body>
    <a class="skip" href="#main">Ir para o conteúdo</a>
    <Header
      home={home}
      by={pt.nav.by}
      byHref={`${home}#${pt.operator.id}`}
      navLabel="Documentos"
      links={[
        { href: `${home}privacidade/`, label: 'Privacidade', hideSmall: true },
        { href: `${home}termos/`, label: 'Termos de uso', hideSmall: true },
        { href: `${home}exclusao-de-dados/`, label: 'Exclusão de dados', hideSmall: true },
      ]}
    />
    <main id="main" class="legal wrap">
      <slot />
    </main>
    <Footer f={pt.footer} />
  </body>
</html>

<style is:global>
  .legal{max-width:72ch;padding-block:var(--s6) var(--s8);color:var(--ink);line-height:1.65}
  .legal h1{font-size:var(--t-2xl);line-height:1.15;margin:0 0 var(--s3)}
  .legal h2{font-size:var(--t-lg);margin:var(--s7) 0 var(--s2)}
  .legal p,.legal li{font-size:var(--t-base)}
  .legal ul,.legal ol{padding-left:1.25em}
  .legal li+li{margin-top:var(--s2)}
  .legal a{color:var(--accent-strong)}
  .legal code{font-size:.92em;background:var(--accent-soft);padding:1px 5px;border-radius:4px}
</style>
