---
import { Font } from 'astro:assets';
import '../styles/global.css';
import type { Dict } from '../i18n/pt';
import { pt } from '../i18n/pt';
import { en } from '../i18n/en';

interface Props {
  t: Dict;
}
const { t } = Astro.props;

const root = new URL(import.meta.env.BASE_URL, Astro.site);
const abs = (path: string) => new URL(path.replace(/^\//, ''), root).href;
const canonical = abs(t.path);
const ogImage = abs(t.lang === 'en' ? 'og-en.png' : 'og.png');
const favicon = `${import.meta.env.BASE_URL}favicon.svg`;
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta name="theme-color" content="#fbf6f8" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={pt.lang} href={abs(pt.path)} />
    <link rel="alternate" hreflang={en.lang} href={abs(en.path)} />
    <link rel="alternate" hreflang="x-default" href={abs(pt.path)} />
    <link rel="sitemap" href={abs('sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vera" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-nunito" preload />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <slot />
  </body>
</html>
