# Vera auto-hospedada. Copie para `.env` e preencha.
# Gere cada segredo com: openssl rand -hex 32

# --- Obrigatórios ---
POSTGRES_PASSWORD=
JWT_SECRET=
# Exatamente 64 caracteres hexadecimais (openssl rand -hex 32). Guarde: sem ela, os dados cifrados não abrem mais.
CRYPTO_KEY_HEX=
SWAGGER_PASSWORD=
QUEUES_DASHBOARD_PASSWORD=

# --- Endereços ---
# Onde o navegador acessa a API e o front-end. Mudou? Rode `docker compose up -d --build`.
PUBLIC_API_URL=http://localhost:3333
APP_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
# true quando o front-end e a API estiverem atrás de HTTPS
COOKIE_SECURE=false
API_PORT=3333
WEB_PORT=8080

# --- E-mail ---
# Padrão: caixa de teste (Mailpit, http://localhost:8025). Para enviar de verdade, aponte para o seu SMTP.
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM_EMAIL=no-reply@seu-dominio.example
MAIL_FROM_NAME=Vera
# Destinatários aceitos: * libera todos; ou liste e-mails e domínios (ana@x.com,@empresa.com)
MAIL_ALLOWED_RECIPIENTS=*

# --- Opcionais: login social (deixe vazio para desligar o botão) ---
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
